{
  "name": "kiri-studio",
  "productName": "Kiri Studio",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop app that lets site owners edit and publish their Kirigami site — no Git, no code, one Publish button.",
  "license": "GPL-3.0-or-later",
  "author": "Maxime Larrivée-Roy",
  "homepage": "https://github.com/php-kirigami/kiri-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/php-kirigami/kiri-studio.git"
  },
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && node scripts/start.js",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "dist": "node scripts/build.js && electron-builder --publish never"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "electron-updater": "^6.8.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
